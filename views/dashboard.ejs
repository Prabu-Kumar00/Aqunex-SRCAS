<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aqunex - Dashboard</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100% !important; height: 100dvh !important; width: 100vw; overflow: hidden !important; }
    body { font-family: 'Inter', 'Segoe UI', sans-serif; background: #0f172a; display: flex; flex-direction: column; }

    /* HEADER & NAV */
    .main-nav { flex-shrink: 0; z-index: 1000; }
    .header { display: none; }

    /* STATS BAR */
    .stats-bar { flex-shrink: 0; z-index: 999; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: #fff; display: flex; justify-content: center; align-items: center; gap: 4px; padding: 8px 16px; font-size: 13px; border-top: 1px solid rgba(14,165,233,0.15); border-bottom: 1px solid rgba(14,165,233,0.12); box-shadow: 0 2px 12px rgba(0,0,0,0.3); animation: slideDown 0.4s ease-out; }
    @keyframes slideDown { from { transform: translateY(-100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    .stat-item { display: flex; align-items: center; gap: 8px; white-space: nowrap; padding: 5px 14px; border-radius: 8px; transition: background 0.2s; cursor: default; }
    .stat-item:hover { background: rgba(255,255,255,0.06); }
    .stat-icon { font-size: 16px; }
    .stat-value { font-weight: 700; font-size: 15px; }
    .stat-label { opacity: 0.6; font-size: 10px; text-transform: uppercase; letter-spacing: 0.8px; }
    .stat-divider { width: 1px; height: 28px; background: rgba(255,255,255,0.1); margin: 0 4px; }
    .stat-alert { color: #f87171; }
    .stat-good { color: #4ade80; }
    .stat-orange { color: #fb923c; }

    /* MAP WRAPPER & CONTAINER */
    #map-wrapper { flex: 1; width: 100%; min-height: 0; position: relative; overflow: hidden; }
    #map { width: 100%; height: 100%; min-height: 0; background: #0b0f19; touch-action: pan-x pan-y; overscroll-behavior: contain; }

    /* CLUSTERS */
    .marker-cluster-small { background-color: rgba(14, 165, 233, 0.35) !important; border: 1px solid rgba(14, 165, 233, 0.6) !important; box-shadow: 0 0 15px rgba(14, 165, 233, 0.4) !important; }
    .marker-cluster-small div { background-color: rgba(14, 165, 233, 0.85) !important; color: #fff !important; font-weight: 700 !important; }
    .marker-cluster-medium { background-color: rgba(245, 158, 11, 0.35) !important; border: 1px solid rgba(245, 158, 11, 0.6) !important; box-shadow: 0 0 15px rgba(245, 158, 11, 0.4) !important; }
    .marker-cluster-medium div { background-color: rgba(245, 158, 11, 0.85) !important; color: #fff !important; font-weight: 700 !important; }
    .marker-cluster-large { background-color: rgba(239, 68, 68, 0.35) !important; border: 1px solid rgba(239, 68, 68, 0.6) !important; box-shadow: 0 0 15px rgba(239, 68, 68, 0.4) !important; }
    .marker-cluster-large div { background-color: rgba(239, 68, 68, 0.85) !important; color: #fff !important; font-weight: 700 !important; }

    /* MARKERS & HOVER FEEDBACK */
    @keyframes markerPulseRing {
      0% { transform: scale(1); opacity: 0.85; }
      70%, 100% { transform: scale(1.65); opacity: 0; }
    }
    .custom-marker { 
      width: 32px !important; 
      height: 32px !important; 
      border-radius: 50%; 
      cursor: pointer; 
      background: transparent !important;
      will-change: transform;
    }
    .marker-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid rgba(255,255,255,0.9);
      transform-origin: center center;
      transition: transform 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.22s ease;
      will-change: transform;
    }
    .custom-marker:hover .marker-inner {
      transform: scale(1.28);
      box-shadow: 0 0 18px rgba(14, 165, 233, 0.9);
      z-index: 99;
    }
    .marker-inner::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 50%;
      opacity: 0;
      z-index: -1;
      transform-origin: center center;
      animation: markerPulseRing 2.4s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
      animation-delay: var(--pulse-delay, 0s);
      will-change: transform, opacity;
    }
    .marker-good .marker-inner { background: #22c55e; }
    .marker-good .marker-inner::after { background: rgba(34, 197, 94, 0.75); }

    .marker-moderate .marker-inner { background: #f59e0b; }
    .marker-moderate .marker-inner::after { background: rgba(245, 158, 11, 0.75); }

    .marker-alert .marker-inner { background: #ef4444; }
    .marker-alert .marker-inner::after { background: rgba(239, 68, 68, 0.85); }

    .marker-esp32 .marker-inner { background: #06b6d4; border-color: #38bdf8 !important; }
    .marker-esp32 .marker-inner::after { background: rgba(6, 182, 212, 0.85); }

    @media (prefers-reduced-motion: reduce) {
      .marker-inner::after { animation: none !important; }
    }

    /* POPUP STYLING & RESPONSIVENESS */
    .leaflet-popup { touch-action: pan-x pan-y; }
    .leaflet-popup-content-wrapper { background: rgba(15, 23, 42, 0.95) !important; color: #f8fafc !important; border-radius: 14px !important; border: 1px solid rgba(14, 165, 233, 0.35) !important; box-shadow: 0 12px 36px rgba(0,0,0,0.75) !important; backdrop-filter: blur(16px); }
    .leaflet-popup-tip { background: #0f172a !important; }
    .leaflet-popup-content { margin: 0; width: calc(100vw - 40px) !important; max-width: 380px !important; min-width: 260px !important; padding: 0; }
    .popup-header { background: linear-gradient(135deg, #0284c7 0%, #4f46e5 100%) !important; color: white; padding: 14px 16px; border-radius: 12px 12px 0 0; }
    .popup-header.esp32-header { background: linear-gradient(135deg, #0891b2 0%, #0284c7 100%) !important; }
    .popup-title { font-size: 16px; font-weight: bold; margin-bottom: 3px; color: #fff; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .popup-subtitle { font-size: 11px; opacity: 0.9; color: rgba(255,255,255,0.85); }
    .popup-body { padding: 14px 16px; }
    .data-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; width: 100%; }
    .data-item { background: rgba(30, 41, 59, 0.75) !important; padding: 8px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); border-left: 3px solid #38bdf8 !important; min-width: 0; }
    .data-item.plastic { border-left-color: #f97316 !important; }
    .data-label { font-size: 10px; color: #94a3b8 !important; text-transform: uppercase; margin-bottom: 3px; }
    .data-value { font-size: 14px; font-weight: bold; color: #f8fafc !important; }
    .data-section-title { font-size: 10px; color: #0ea5e9; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; margin: 10px 0 6px; padding-left: 2px; }
    .meta-info { display: flex; justify-content: space-between; align-items: center; margin: 10px 0; font-size: 11px; color: #94a3b8 !important; }
    .meta-item { display: flex; align-items: center; gap: 4px; }
    .severity-badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: bold; }
    .severity-low { background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
    .severity-moderate { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .severity-high { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .status-active { display: inline-block; padding: 3px 10px; background: #22c55e; color: white; border-radius: 12px; font-size: 11px; font-weight: bold; }
    .source-badge { display: inline-block; padding: 3px 8px; border-radius: 12px; font-size: 10px; font-weight: bold; margin-left: 6px; }
    .source-esp32 { background: rgba(6, 182, 212, 0.2); color: #38bdf8; border: 1px solid rgba(6, 182, 212, 0.3); }
    .download-btn { display: block; width: 100%; padding: 10px; background: linear-gradient(135deg, #0284c7, #4f46e5); color: white; text-align: center; border: none; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600; margin-top: 12px; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .download-btn:hover { background: linear-gradient(135deg, #0369a1, #4338ca); transform: translateY(-1px); box-shadow: 0 4px 15px rgba(2, 132, 199, 0.4); }

    /* REDESIGNED LOADING SCREEN OVERLAY */
    #loadingScreen {
      position: fixed;
      inset: 0;
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #060d1a;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }

    #loadingScreen.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    #loadingScreen .loading-card {
      width: min(420px, calc(100vw - 40px));
      padding: 2rem;
      text-align: center;
      border-radius: 20px;
      background: linear-gradient(
        145deg,
        rgba(15, 35, 58, 0.98),
        rgba(10, 22, 40, 0.98)
      );
      border: 1px solid rgba(14, 165, 233, 0.35);
      box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.55),
        0 0 35px rgba(14, 165, 233, 0.12);
      color: #f8fafc;
      font-family: 'Inter', sans-serif;
    }

    #loadingScreen .loading-card h2 {
      font-size: 1.6rem;
      font-weight: 700;
      margin-bottom: 0.50rem;
      color: #f8fafc;
      font-family: 'Outfit', sans-serif;
    }

    #loadingScreen .loading-card p {
      font-size: 0.92rem;
      color: #94a3b8;
      margin: 0;
    }

    .loading-spinner {
      width: 48px;
      height: 48px;
      margin: 0 auto 1.25rem;
      border-radius: 50%;
      border: 3px solid rgba(14, 165, 233, 0.18);
      border-top-color: #0ea5e9;
      border-right-color: #06b6d4;
      animation: loadingSpin 0.9s linear infinite;
    }

    @keyframes loadingSpin {
      to {
        transform: rotate(360deg);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .loading-spinner {
        animation: none;
        border-top-color: #0ea5e9;
        border-right-color: #0ea5e9;
      }

      #loadingScreen {
        transition: none;
      }
    }

    /* LEAFLET CONTROLS DARK GLASSMORPHIC THEME */
    .leaflet-control-zoom { border: 1px solid rgba(14, 165, 233, 0.3) !important; border-radius: 10px !important; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.5) !important; backdrop-filter: blur(12px); margin-left: 14px !important; margin-top: 14px !important; }
    .leaflet-control-zoom a { background-color: rgba(15, 23, 42, 0.9) !important; color: #0ea5e9 !important; border-bottom-color: rgba(14, 165, 233, 0.2) !important; font-weight: 700 !important; transition: all 0.2s ease !important; }
    .leaflet-control-zoom a:hover { background-color: rgba(30, 41, 59, 0.95) !important; color: #38bdf8 !important; }
    .leaflet-bar { border: none !important; }

    .leaflet-control-geocoder { background: rgba(15, 23, 42, 0.9) !important; border: 1px solid rgba(14, 165, 233, 0.35) !important; border-radius: 10px !important; box-shadow: 0 4px 16px rgba(0,0,0,0.5) !important; backdrop-filter: blur(12px); margin-top: 14px !important; margin-right: 14px !important; }
    .leaflet-control-geocoder-icon { background-color: transparent !important; filter: invert(60%) sepia(80%) saturate(1000%) hue-rotate(170deg); }
    .leaflet-control-geocoder-form input { background: transparent !important; color: #e2e8f0 !important; font-size: 13px !important; padding: 6px 10px !important; }
    .leaflet-control-geocoder-throbber .leaflet-control-geocoder-icon { filter: none !important; }

    /* LEAFLET GEOCODER DROPDOWN & ERROR MATCHING THEME */
    .leaflet-control-geocoder-alternatives,
    .leaflet-control-geocoder-error {
      background: rgba(15, 23, 42, 0.95) !important;
      color: #e2e8f0 !important;
      border-top: 1px solid rgba(14, 165, 233, 0.2) !important;
      backdrop-filter: blur(12px);
    }
    .leaflet-control-geocoder-alternatives li {
      border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
    }
    .leaflet-control-geocoder-alternatives a, 
    .leaflet-control-geocoder-alternatives a:hover {
      color: #e2e8f0 !important;
      text-decoration: none !important;
      padding: 8px 12px !important;
      display: block !important;
    }
    .leaflet-control-geocoder-alternatives li:hover,
    .leaflet-control-geocoder-alternatives li.leaflet-control-geocoder-selected {
      background: rgba(14, 165, 233, 0.15) !important;
    }

    .leaflet-control-attribution { background: rgba(15, 23, 42, 0.75) !important; color: #64748b !important; font-size: 10px !important; backdrop-filter: blur(8px); border-radius: 6px 0 0 0 !important; }
    .leaflet-control-attribution a { color: #0ea5e9 !important; text-decoration: none; }

    /* MAP FLOATING CONTROLS GROUP */
    .map-controls-group {
      position: absolute;
      top: 76px;
      right: 14px;
      z-index: 1001;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      pointer-events: auto;
    }
    .map-fab {
      background: rgba(15, 23, 42, 0.9);
      color: #0ea5e9;
      border: 1px solid rgba(14, 165, 233, 0.35);
      border-radius: 10px;
      padding: 8px 14px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.4);
      backdrop-filter: blur(12px);
      transition: all 0.2s ease;
      min-width: 132px;
      justify-content: center;
      white-space: nowrap;
    }
    .map-fab:hover { background: rgba(30, 41, 59, 0.95); border-color: rgba(14, 165, 233, 0.6); color: #38bdf8; transform: translateY(-1px); }
    .filter-badge { display: none; align-items: center; justify-content: center; background: #0ea5e9; color: #fff; width: 17px; height: 17px; border-radius: 50%; font-size: 0.62rem; font-weight: 700; }

    /* FILTER PANEL */
    .filter-panel {
      position: absolute;
      top: 146px;
      right: 14px;
      z-index: 1002;
      background: rgba(15, 23, 42, 0.95);
      border: 1px solid rgba(14,165,233,0.3);
      border-radius: 14px;
      width: 275px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.65);
      display: none;
      overflow: hidden;
      backdrop-filter: blur(16px);
    }
    .filter-panel.open { display: block; animation: panelIn 0.18s ease; }
    @keyframes panelIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
    .fp-head { background: rgba(14,165,233,0.08); border-bottom: 1px solid rgba(14,165,233,0.12); padding: 11px 14px; display: flex; justify-content: space-between; align-items: center; }
    .fp-head-title { font-size: 0.8rem; font-weight: 700; color: #f1f5f9; text-transform: uppercase; letter-spacing: 0.5px; }
    .fp-reset { font-size: 0.72rem; color: #0ea5e9; cursor: pointer; background: none; border: none; font-weight: 600; }
    .fp-reset:hover { color: #38bdf8; }
    .fp-section { padding: 11px 14px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .fp-section:last-child { border-bottom: none; }
    .fp-label { font-size: 0.68rem; color: #64748b; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; font-weight: 600; }
    .fp-toggle-row { display: flex; justify-content: space-between; align-items: center; }
    .fp-toggle-txt { font-size: 0.82rem; color: #cbd5e1; }
    .tog { width: 36px; height: 20px; background: rgba(14,165,233,0.15); border: 1px solid rgba(14,165,233,0.25); border-radius: 100px; position: relative; cursor: pointer; transition: all 0.25s; }
    .tog.on { background: rgba(14,165,233,0.45); border-color: #0ea5e9; }
    .tog::after { content: ''; position: absolute; width: 14px; height: 14px; border-radius: 50%; background: #64748b; top: 2px; left: 2px; transition: all 0.25s; }
    .tog.on::after { background: #fff; left: 18px; }
    .fp-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .chip { padding: 4px 10px; border-radius: 100px; font-size: 0.72rem; font-weight: 600; cursor: pointer; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); color: #64748b; transition: all 0.18s; user-select: none; }
    .chip.sel-good   { background: rgba(34,197,94,0.15);  border-color: rgba(34,197,94,0.45);  color: #4ade80; }
    .chip.sel-warn   { background: rgba(245,158,11,0.15); border-color: rgba(245,158,11,0.45); color: #fbbf24; }
    .chip.sel-danger { background: rgba(239,68,68,0.15);  border-color: rgba(239,68,68,0.45);  color: #f87171; }
    .chip.sel-blue   { background: rgba(14,165,233,0.15); border-color: rgba(14,165,233,0.45); color: #0ea5e9; }
    .fp-select { width: 100%; padding: 7px 10px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #e2e8f0; font-size: 0.82rem; outline: none; cursor: pointer; }
    .fp-select:focus { border-color: rgba(14,165,233,0.4); }
    .fp-select option { background: #1e293b; color: #e2e8f0; }

    /* RESPONSIVE BREAKPOINTS */
    @media (max-width: 768px) {
      .stats-bar { gap: 4px; font-size: 11px; padding: 6px 10px; flex-wrap: wrap; }
      .stat-value { font-size: 13px; }
      .stat-label { font-size: 9px; }
      .stat-divider { display: none; }
      .data-grid { grid-template-columns: 1fr; gap: 6px; }
      .meta-info { flex-direction: column; align-items: flex-start; gap: 4px; font-size: 10px; }
      .map-controls-group { right: 10px; gap: 6px; }
      .map-fab { min-width: 110px; padding: 6px 10px; font-size: 11px; }
      .filter-panel { right: 10px; width: calc(100vw - 20px); }
    }
  </style>
</head>
<body>

<div class="loading" id="loadingScreen">
  <div class="loading-card">
    <div class="loading-spinner"></div>
    <h2>🌊 Loading Dashboard</h2>
    <p>Connecting to real-time sensor data...</p>
  </div>
</div>

<!-- FIX 7: Unified Navbar -->
<%- include('partials/header', { page: 'dashboard' }) %>

<div class="stats-bar" id="statsBar">
  <div class="stat-item">
    <span class="stat-icon">🤖</span>
    <div>
      <div class="stat-value" id="statSensors">—</div>
      <div class="stat-label">Active Sensors</div>
    </div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <span class="stat-icon">⚠️</span>
    <div>
      <div class="stat-value stat-alert" id="statAlerts">—</div>
      <div class="stat-label">Alerts</div>
    </div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <span class="stat-icon">🗺️</span>
    <div>
      <div class="stat-value" id="statStates">—</div>
      <div class="stat-label">States Covered</div>
    </div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <span class="stat-icon">📍</span>
    <div>
      <div class="stat-value" id="statLocations">—</div>
      <div class="stat-label">Locations Monitored</div>
    </div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <span class="stat-icon">🧴</span>
    <div>
      <div class="stat-value stat-orange" id="statPlastic">—</div>
      <div class="stat-label">Plastic Hotspots</div>
    </div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <span class="stat-icon">🕐</span>
    <div>
      <div class="stat-value stat-good" id="statLastUpdate">—</div>
      <div class="stat-label">Last Updated</div>
    </div>
  </div>
</div>

<div id="map-wrapper">
  <div id="map"></div>

  <!-- Map Floating Controls Group -->
  <div class="map-controls-group">
    <button class="map-fab" onclick="focusMissionCluster()" title="Zoom to active mission cluster">
      🎯 Focus Mission
    </button>
    <button class="map-fab" onclick="togglePanel()">
      🔍 Filter <span class="filter-badge" id="filterBadge"></span>
    </button>
  </div>

  <!-- Filter Panel -->
  <div class="filter-panel" id="filterPanel">
    <div class="fp-head">
      <span class="fp-head-title">Filter Markers</span>
      <button class="fp-reset" onclick="resetFilters()">Reset All</button>
    </div>
    <div class="fp-section">
      <div class="fp-label">Visibility</div>
      <div class="fp-toggle-row">
        <span class="fp-toggle-txt">Show all markers</span>
        <div class="tog on" id="visTog" onclick="toggleVis(this)"></div>
      </div>
    </div>
    <div class="fp-section">
      <div class="fp-label">Severity</div>
      <div class="fp-chips">
        <div class="chip sel-good"   data-g="sev" data-v="good"     onclick="toggleChip(this)">Good</div>
        <div class="chip sel-warn"   data-g="sev" data-v="moderate" onclick="toggleChip(this)">Moderate</div>
        <div class="chip sel-danger" data-g="sev" data-v="alert"    onclick="toggleChip(this)">Alert</div>
      </div>
    </div>
    <div class="fp-section">
      <div class="fp-label">State</div>
      <select class="fp-select" id="stateSelect" onchange="applyFilters()">
        <option value="all">All States</option>
      </select>
    </div>
    <div class="fp-section">
      <div class="fp-label">Data Source</div>
      <div class="fp-chips">
        <div class="chip sel-blue" data-g="src" data-v="firestore" onclick="toggleChip(this)">Firestore</div>
        <div class="chip sel-blue" data-g="src" data-v="esp32"     onclick="toggleChip(this)">ESP32</div>
      </div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>

<script>
  // FIX 1: firebaseConfig passed from app.js via res.render
  const firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;
  let db, rtdb;
  try {
    firebase.initializeApp(firebaseConfig);
    db   = firebase.firestore();
    rtdb = firebase.database();
  } catch(err) {
    console.error('⚠️ Firebase Initialization Error:', err);
  }

  // Smooth Leaflet Map Initialization
  const map = L.map('map', {
    zoomAnimation: true,
    fadeAnimation: true,
    markerZoomAnimation: true,
    zoomDelta: 0.5,
    zoomSnap: 0.5,
    wheelPxPerZoomLevel: 120,
    minZoom: 3,
    maxZoom: 18,
    tap: true,
    touchZoom: true,
    bounceAtZoomLimits: false
  }).setView([20.5937, 78.9629], 5);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors'
  }).addTo(map);

  const mcg = L.markerClusterGroup({
    maxClusterRadius: 45,
    spiderfyOnMaxZoom: true,
    showCoverageOnHover: false,
    zoomToBoundsOnClick: true,
    disableClusteringAtZoom: 14,
    animate: true,
    animateAddingMarkers: false
  });
  map.addLayer(mcg);

  // Focus Mission Cluster helper function
  function focusMissionCluster() {
    if (mcg && mcg.getLayers().length > 0) {
      map.flyToBounds(mcg.getBounds(), { padding: [50, 50], duration: 1.2 });
    } else {
      map.flyTo([11.0168, 76.9558], 10, { duration: 1.2 });
    }
  }

  // Handle map resizing and orientation changes cleanly
  function invalidateMapSize() {
    if (map) map.invalidateSize();
  }
  window.addEventListener('resize', invalidateMapSize);
  window.addEventListener('orientationchange', () => setTimeout(invalidateMapSize, 200));
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) invalidateMapSize();
  });

  // Isolate map scrolling and dragging from parent smooth scroll interference
  const mapContainerEl = document.getElementById('map');
  if (mapContainerEl) {
    mapContainerEl.addEventListener('wheel', e => e.stopPropagation(), { passive: true });
    mapContainerEl.addEventListener('touchmove', e => e.stopPropagation(), { passive: true });
  }

  var searchMarker = null;
  L.Control.geocoder({
    defaultMarkGeocode: false,
    placeholder: 'Search location...',
    errorMessage: 'Location not found',
    suggestMinLength: 3,
    suggestTimeout: 250,
    queryMinLength: 1
  }).on('markgeocode', function(e) {
    var latlng = e.geocode.center, locationName = e.geocode.name;
    if (searchMarker) map.removeLayer(searchMarker);
    map.setView(latlng, 12);
    searchMarker = L.marker(latlng, {
      icon: L.divIcon({
        className: 'custom-marker',
        html: `<div style="background:#0ea5e9;width:32px;height:32px;border-radius:50%;border:2px solid white;text-align:center;line-height:28px;color:white;font-size:16px;">📍</div>`,
        iconSize: [32, 32]
      })
    }).addTo(map).bindPopup(`<div style="padding:12px"><strong>${locationName}</strong><br><small style="color:#94a3b8">Searched Location</small></div>`).openPopup();
  }).addTo(map);

  // ── Positioning & Click Propagation for Custom Controls ──
  const mapControlsGroup = document.querySelector('.map-controls-group');
  const filterPanel = document.querySelector('.filter-panel');
  if (mapControlsGroup) {
    L.DomEvent.disableClickPropagation(mapControlsGroup);
  }
  if (filterPanel) {
    L.DomEvent.disableClickPropagation(filterPanel);
  }

  // Use ResizeObserver to position custom controls dynamically under the Leaflet geocoder (which can expand)
  const geocoderEl = document.querySelector('.leaflet-control-geocoder');
  if (geocoderEl && mapControlsGroup && filterPanel) {
    const updateControlPositions = () => {
      const isMobile = window.innerWidth <= 768;
      const baseTop = isMobile ? 10 : 14;
      const gap = isMobile ? 6 : 8;
      const geocoderHeight = geocoderEl.getBoundingClientRect().height;
      const controlsTop = baseTop + geocoderHeight + gap;
      
      mapControlsGroup.style.top = `${controlsTop}px`;
      
      const groupHeight = mapControlsGroup.getBoundingClientRect().height;
      filterPanel.style.top = `${controlsTop + groupHeight + gap}px`;
    };

    const resizeObserver = new ResizeObserver(() => {
      updateControlPositions();
    });
    resizeObserver.observe(geocoderEl);
    resizeObserver.observe(mapControlsGroup);
    
    // Add event listeners on transition/focus/blur to account for instant height shifts in the geocoder input
    const geocoderInput = geocoderEl.querySelector('input');
    if (geocoderInput) {
      geocoderInput.addEventListener('focus', () => setTimeout(updateControlPositions, 100));
      geocoderInput.addEventListener('blur', () => setTimeout(updateControlPositions, 100));
      geocoderInput.addEventListener('input', () => setTimeout(updateControlPositions, 50));
    }
  }

  // ── Helpers ──
  function getSevKey(c) {
    const r = Math.min(Math.floor(c / 3), 10);
    return r < 4 ? 'good' : r < 7 ? 'moderate' : 'alert';
  }
  function getSeverity(c) {
    const k = getSevKey(c);
    if (k === 'good')     return { rating: Math.min(Math.floor(c/3),10), class: 'severity-low',      markerClass: 'marker-good' };
    if (k === 'moderate') return { rating: Math.min(Math.floor(c/3),10), class: 'severity-moderate', markerClass: 'marker-moderate' };
                          return { rating: Math.min(Math.floor(c/3),10), class: 'severity-high',     markerClass: 'marker-alert' };
  }
  function getPollutionType(c) { return c > 15 ? 'Algae Bloom' : 'Organic Matter'; }

  function formatTimestamp(ts) {
    if (!ts) return 'N/A';
    try {
      const date = typeof ts.toDate === 'function' ? ts.toDate() : new Date(ts);
      return date.toLocaleString('en-IN', { dateStyle: 'short', timeStyle: 'short' });
    } catch(e) { return 'N/A'; }
  }

  function createDownloadFn(location, chlorophyll, turbidity, ph, temperature, microplasticIndex, plasticDensity) {
    return function() {
      const safeLoc = location || 'Unknown';
      const csv = `Water Quality Report - ${safeLoc}\n${new Date().toLocaleDateString()}\nParameter,Value,Unit\nChlorophyll-a,${chlorophyll},µg/L\nTurbidity,${turbidity},NTU\npH,${ph},-\nTemperature,${temperature},°C\nMicroplastic Index,${microplasticIndex ?? 'N/A'},µg/L\nPlastic Density,${plasticDensity ?? 'N/A'},/m³`;
      const blob = new Blob([csv], { type: 'text/csv' });
      const url  = window.URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href     = url;
      a.download = `${safeLoc.replace(/[^a-zA-Z0-9]/g,'_')}_Report.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
    };
  }

  function createMarker(data, source, docId) {
    try {
      if (!data || !data.gps) return;
      const lat = parseFloat(data.gps.lat);
      const lng = parseFloat(data.gps.lng);
      if (isNaN(lat) || isNaN(lng)) {
        console.warn('⚠️ Invalid or missing GPS coordinates for marker:', docId);
        return;
      }
      
      const sev         = getSeverity(data.chlorophyll || 0);
      const markerClass = source === 'esp32' ? 'marker-esp32' : sev.markerClass;

      let hash = 0;
      const idStr = String(docId || 'unknown_id');
      for (let i = 0; i < idStr.length; i++) hash = (hash << 5) - hash + idStr.charCodeAt(i);
      const pulseDelay = (Math.abs(hash) % 8) * 0.3;

      const icon        = L.divIcon({
        className: `custom-marker ${markerClass}`,
        html: `<div class="marker-inner" style="--pulse-delay: ${pulseDelay}s; font-size:16px;">💧</div>`,
        iconSize: [32, 32]
      });
      
      const fn = `dl${idStr.replace(/[^a-zA-Z0-9]/g,'')}`;
      const safeLoc = data.location || 'Unknown';
      window[fn] = createDownloadFn(safeLoc, data.chlorophyll, data.turbidity, data.ph, data.temperature, data.microplasticIndex, data.plasticDensity);

      const sourceBadge = source === 'esp32' ? `<span class="source-badge source-esp32">ESP32</span>` : '';
      const hc          = source === 'esp32' ? 'popup-header esp32-header' : 'popup-header';

      const popup = `
        <div class="${hc}">
          <div class="popup-title">${safeLoc} ${sourceBadge}</div>
          <div class="popup-subtitle">${data.district || 'N/A'}, ${data.state || 'N/A'}</div>
        </div>
        <div class="popup-body">
          <div class="data-section-title">💧 Water Quality</div>
          <div class="data-grid">
            <div class="data-item"><div class="data-label">Chlorophyll-a</div><div class="data-value">${data.chlorophyll !== undefined ? data.chlorophyll : 'N/A'} µg/L</div></div>
            <div class="data-item"><div class="data-label">Turbidity</div><div class="data-value">${data.turbidity !== undefined ? data.turbidity : 'N/A'} NTU</div></div>
            <div class="data-item"><div class="data-label">pH</div><div class="data-value">${data.ph !== undefined ? data.ph : 'N/A'}</div></div>
            <div class="data-item"><div class="data-label">Temperature</div><div class="data-value">${data.temperature !== undefined ? data.temperature : 'N/A'}°C</div></div>
          </div>
          <div class="data-section-title">🧴 Microplastics & Spectral</div>
          <div class="data-grid">
            <div class="data-item plastic"><div class="data-label">Microplastic Index</div><div class="data-value">${data.microplasticIndex != null ? data.microplasticIndex + ' µg/L' : 'N/A'}</div></div>
            <div class="data-item plastic"><div class="data-label">Plastic Density</div><div class="data-value">${data.plasticDensity != null ? data.plasticDensity + '/m³' : 'N/A'}</div></div>
          </div>
          <div class="meta-info">
            <div class="meta-item"><strong>Type</strong> ${getPollutionType(data.chlorophyll || 0)}</div>
            <div class="meta-item"><strong>Severity</strong> <span class="severity-badge ${sev.class}">${sev.rating}/10</span></div>
          </div>
          <div class="meta-info">
            <div class="meta-item"><span class="status-active">ACTIVE</span></div>
            <div class="meta-item" style="font-size:10px;color:#999">${formatTimestamp(data.timestamp)}</div>
          </div>
          <button class="download-btn" onclick="${fn}()">⬇ Download Data Report</button>
        </div>`;
      mcg.addLayer(L.marker([lat, lng], { icon }).bindPopup(popup, { maxWidth: 400, minWidth: 360 }));
    } catch(err) {
      console.error('⚠️ Error creating marker for docId:', docId, err);
    }
  }

  // ── Data Store ──
  let allData = [];
  function clearMarkers() { mcg.clearLayers(); }

  function updateStatsBar(docs) {
    if (!docs || !docs.length) {
      ['statSensors','statAlerts','statStates','statLocations','statPlastic'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.textContent = '0'; el.setAttribute('data-val', '0'); }
      });
      document.getElementById('statLastUpdate').textContent = '—';
      return;
    }
    const states = new Set(), locations = new Set();
    let lastTs = 0, alerts = 0, plastic = 0;
    docs.forEach(d => {
      if (d.state)    states.add(d.state);
      if (d.location) locations.add(d.location);
      let ts = 0;
      if (d.timestamp && typeof d.timestamp.toDate === 'function') ts = d.timestamp.toDate().getTime();
      else if (d.timestamp) ts = new Date(d.timestamp).getTime();
      if (ts > lastTs) lastTs = ts;
      if (Math.min(Math.floor((d.chlorophyll || 0) / 3), 10) >= 8) alerts++;
      if ((d.microplasticIndex || 0) > 8) plastic++;
    });
    animateCountUp('statSensors', docs.length);
    animateCountUp('statAlerts', alerts);
    document.getElementById('statAlerts').className = alerts > 0 ? 'stat-value stat-alert' : 'stat-value stat-good';
    animateCountUp('statStates', states.size);
    animateCountUp('statLocations', locations.size);
    animateCountUp('statPlastic', plastic);
    document.getElementById('statLastUpdate').textContent = lastTs > 0
      ? new Date(lastTs).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '—';
  }

  function populateStates(docs) {
    const sel = document.getElementById('stateSelect'), cur = sel.value;
    const states = [...new Set(docs.map(d => d.state).filter(Boolean))].sort();
    sel.innerHTML = '<option value="all">All States</option>';
    states.forEach(s => {
      const o = document.createElement('option');
      o.value = s; o.textContent = s;
      if (s === cur) o.selected = true;
      sel.appendChild(o);
    });
  }

  // ── Filter Logic ──
  const F = { sev: new Set(['good','moderate','alert']), src: new Set(['firestore','esp32']), state: 'all', visible: true };

  function redrawMarkers() {
    clearMarkers();
    if (!F.visible) return;
    allData.forEach(({ data, source, docId }) => {
      if (!F.sev.has(getSevKey(data.chlorophyll || 0))) return;
      if (!F.src.has(source)) return;
      if (F.state !== 'all' && data.state !== F.state) return;
      createMarker(data, source, docId);
    });
  }

  function applyFilters() { F.state = document.getElementById('stateSelect').value; redrawMarkers(); updateBadge(); }
  function togglePanel()   { document.getElementById('filterPanel').classList.toggle('open'); }
  function toggleVis(el)   {
    el.classList.toggle('on');
    F.visible = el.classList.contains('on');
    F.visible ? map.addLayer(mcg) : map.removeLayer(mcg);
  }
  function toggleChip(chip) {
    const g = chip.dataset.g, v = chip.dataset.v, set = F[g];
    const selClass = [...chip.classList].find(c => c.startsWith('sel-'));
    if (set.has(v)) {
      if (set.size === 1) return;
      set.delete(v); chip.classList.remove(selClass); chip.style.opacity = '0.35';
    } else {
      set.add(v); if (selClass) chip.classList.add(selClass); chip.style.opacity = '1';
    }
    redrawMarkers(); updateBadge();
  }
  function resetFilters() {
    F.sev = new Set(['good','moderate','alert']);
    F.src = new Set(['firestore','esp32']);
    F.state = 'all'; F.visible = true;
    document.getElementById('stateSelect').value = 'all';
    document.querySelectorAll('.chip').forEach(c => {
      const sc = [...c.classList].find(x => x.startsWith('sel-'));
      if (sc) { c.classList.add(sc); c.style.opacity = '1'; }
    });
    const vt = document.getElementById('visTog');
    vt.classList.add('on');
    if (!map.hasLayer(mcg)) map.addLayer(mcg);
    redrawMarkers(); updateBadge();
  }
  function updateBadge() {
    const n = (3 - F.sev.size) + (2 - F.src.size) + (F.state !== 'all' ? 1 : 0) + (!F.visible ? 1 : 0);
    const b = document.getElementById('filterBadge');
    b.style.display = n > 0 ? 'inline-flex' : 'none';
    b.textContent   = n;
  }

  // ── Firebase ──

  if (db) {
    db.collection('sensor_data').onSnapshot(snapshot => {
      // Hide loading screen when first data arrives
      const loadingScreen = document.getElementById('loadingScreen');
      if (loadingScreen) loadingScreen.classList.add('is-hidden');
      invalidateMapSize();

      allData = allData.filter(d => d.source !== 'firestore');
      const docs = [];
      snapshot.forEach(doc => {
        try {
          const data = doc.data();
          if (data) {
            docs.push(data);
            allData.push({ data, source: 'firestore', docId: doc.id });
          }
        } catch (err) {
          console.warn('⚠️ Error processing firestore doc:', doc.id, err);
        }
      });
      
      try {
        updateStatsBar(docs);
      } catch (err) {
        console.error('⚠️ Error updating stats bar:', err);
      }
      
      try {
        populateStates(docs);
      } catch (err) {
        console.warn('⚠️ Error populating states:', err);
      }
      
      redrawMarkers();
    }, err => {
      console.error('Firestore error:', err.message);
      const loadingScreen = document.getElementById('loadingScreen');
      if (loadingScreen) {
        const card = loadingScreen.querySelector('.loading-card') || loadingScreen;
        card.innerHTML = `
          <div style="font-size: 3rem; margin-bottom: 1rem;">❌</div>
          <h2 style="color: #f87171; margin-bottom: 0.5rem; font-family: 'Outfit', sans-serif;">Unable to connect to sensor data</h2>
          <p style="color: #94a3b8; font-size: 13px; margin-bottom: 1.5rem;">${err.message || 'Unknown network error occurred.'}</p>
          <button onclick="window.location.reload()" style="background: #0ea5e9; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background 0.2s; font-family: 'Inter', sans-serif;">Retry Connection</button>
        `;
      }
    });
  } else {
    // Hide loading screen if db is not initialized
    const loadingScreen = document.getElementById('loadingScreen');
    if (loadingScreen) loadingScreen.classList.add('is-hidden');
    setTimeout(invalidateMapSize, 500);
  }

  // Called ONCE here — NOT inside onSnapshot
  function loadRtdb() {
    try {
      rtdb.ref('sensorData').once('value', snap => {
        const data = snap.val();
        if (data) {
          Object.keys(data).forEach(key => {
            if (!allData.find(d => d.docId === key && d.source === 'esp32')) {
              allData.push({ data: data[key], source: 'esp32', docId: key });
            }
          });
          redrawMarkers();
        }
      }, err => {
        console.warn('⚠️ RTDB read permission warning:', err.message);
      });

      rtdb.ref('sensorData').on('child_added', snap => {
        const key = snap.key;
        if (!allData.find(d => d.docId === key && d.source === 'esp32')) {
          allData.push({ data: snap.val(), source: 'esp32', docId: key });
          redrawMarkers();
        }
      }, err => {
        console.warn('⚠️ RTDB child_added permission warning:', err.message);
      });

      // No recursive loadRtdb() — just update the changed entry in-place
      rtdb.ref('sensorData').on('child_changed', snap => {
        const key = snap.key;
        allData = allData.filter(d => !(d.docId === key && d.source === 'esp32'));
        allData.push({ data: snap.val(), source: 'esp32', docId: key });
        redrawMarkers();
      }, err => {
        console.warn('⚠️ RTDB child_changed permission warning:', err.message);
      });
    } catch(err) {
      console.error('⚠️ Error initializing RTDB listeners:', err);
    }
  }

  loadRtdb();
</script>

<!-- Mock Panel (Ctrl+M) -->
<div id="mockControlPanel" style="display:none;position:fixed;bottom:20px;right:20px;background:white;padding:20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,0.3);z-index:10000;min-width:260px;">
  <h3 style="margin:0 0 12px 0;font-size:16px;">Mock Data Control</h3>
  <div style="display:flex;flex-direction:column;gap:8px;">
    <button id="startMockBtn"   class="btn" style="margin:0;width:100%;">▶ Start Mock Data</button>
    <button id="stopMockBtn"    class="btn" style="margin:0;width:100%;background:#dc3545;border-color:#dc3545;color:white;">⏹ Stop</button>
    <button id="cleanupMockBtn" class="btn" style="margin:0;width:100%;background:#ffc107;border-color:#ffc107;color:#333;">🧹 Cleanup</button>
    <button id="closePanelBtn"  class="btn" style="margin:0;width:100%;background:#6c757d;border-color:#6c757d;color:white;">✕ Close</button>
  </div>
  <div id="mockStatus" style="margin-top:10px;padding:8px;background:#f8f9fa;border-radius:5px;font-size:12px;"></div>
</div>

<script>
  document.addEventListener('keydown', e => {
    if (e.ctrlKey && e.key === 'm') {
      const p = document.getElementById('mockControlPanel');
      p.style.display = p.style.display === 'none' ? 'block' : 'none';
    }
  });
  function showStatus(msg, err = false) {
    const s = document.getElementById('mockStatus');
    s.textContent  = msg;
    s.style.color  = err ? '#dc3545' : '#28a745';
  }
  async function callMockApi(path) {
    try {
      const r = await fetch(path, { method: 'POST' });
      const d = await r.json();
      showStatus(d.message + (d.success ? ' ✓' : ''), !d.success);
    } catch(e) { showStatus(e.message, true); }
  }
  document.getElementById('startMockBtn').addEventListener('click',   () => callMockApi('/api/mock/start'));
  document.getElementById('stopMockBtn').addEventListener('click',    () => callMockApi('/api/mock/stop'));
  document.getElementById('cleanupMockBtn').addEventListener('click', () => { if (confirm('Delete all mock data?')) callMockApi('/api/mock/cleanup'); });
  document.getElementById('closePanelBtn').addEventListener('click',  () => { document.getElementById('mockControlPanel').style.display = 'none'; });

  async function refreshMockStatus() {
    try {
      const r = await fetch('/api/mock/status');
      const d = await r.json();
      showStatus(d.running ? '🟢 Mock RUNNING' : '🔴 Mock STOPPED', !d.running);
    } catch(e) { showStatus('Cannot reach mock API', true); }
  }
  refreshMockStatus();
  setInterval(refreshMockStatus, 5000);
</script>

</body>
</html>
