<%- include('partials/header') %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Inter', 'Segoe UI', sans-serif;
    overflow: hidden;
    height: 100vh;
    background: #060d1a;
    color: #f8fafc;
  }

  #mission-app {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 60px);
    position: relative;
    background: #060d1a;
  }

  /* ── SIMULATION DISCLAIMER BAR ── */
  .sim-disclaimer-bar {
    background: linear-gradient(90deg, rgba(14, 165, 233, 0.15), rgba(99, 102, 241, 0.2));
    border-bottom: 1px solid rgba(14, 165, 233, 0.25);
    padding: 6px 16px;
    font-size: 11px;
    font-weight: 600;
    color: #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    letter-spacing: 0.5px;
    z-index: 12;
    flex-shrink: 0;
  }
  .sim-disclaimer-bar i { color: #0ea5e9; }

  /* ── STATS BAR ── */
  #stats-bar {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-bottom: 1px solid rgba(14, 165, 233, 0.2);
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 6px 12px;
    min-height: 44px;
    flex-shrink: 0;
    z-index: 11;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  }
  .stat-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2px 12px;
  }
  .stat-icon { font-size: 15px; }
  .stat-num  { font-size: 13px; font-weight: 700; color: #f8fafc; font-family: 'Outfit', sans-serif; }
  .stat-lbl  { font-size: 9px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; }

  /* ── MISSION HEADER & COMPACT VIEW SWITCHER ── */
  #mission-header {
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid rgba(14, 165, 233, 0.2);
    color: #fff;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 700;
    font-family: 'Outfit', sans-serif;
    flex-shrink: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .header-brand-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .view-switcher-pills {
    display: flex;
    align-items: center;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(14, 165, 233, 0.3);
    border-radius: 20px;
    padding: 3px;
    gap: 2px;
  }
  .view-pill {
    padding: 4px 14px;
    border-radius: 16px;
    border: none;
    background: transparent;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
  }
  .view-pill:hover { color: #f8fafc; }
  .view-pill.active {
    background: linear-gradient(135deg, #0ea5e9, #0284c7);
    color: #ffffff;
    box-shadow: 0 0 10px rgba(14, 165, 233, 0.4);
  }

  .state-badge {
    font-size: 10px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
  }
  .state-PLANNING  { background: rgba(14, 165, 233, 0.2); color: #38bdf8; border: 1px solid rgba(14, 165, 233, 0.4); }
  .state-READY     { background: rgba(139, 92, 246, 0.25); color: #a78bfa; border: 1px solid rgba(139, 92, 246, 0.4); }
  .state-RUNNING   { background: rgba(34, 197, 94, 0.25); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.4); }
  .state-PAUSED    { background: rgba(245, 158, 11, 0.25); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }
  .state-COMPLETED { background: rgba(16, 185, 129, 0.25); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }
  .state-ABORTED   { background: rgba(239, 68, 68, 0.25); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); }

  /* ── MAP CONTAINER ── */
  #map-container { position: relative; flex: 1; min-height: 0; }
  #mission-map   { width: 100%; height: 100%; background: #0b0f19; }

  /* ── OVERLAYS ── */
  .m-overlay { position: absolute; z-index: 500; pointer-events: none; }
  .m-overlay * { pointer-events: auto; }

  /* ── GLASSMORPHIC PANELS ── */
  .dark-panel {
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(14, 165, 233, 0.25);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.5);
    color: #f8fafc;
  }

  .panel-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #38bdf8;
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(14, 165, 233, 0.2);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── PLAN OVERLAY PANEL ── */
  #plan-overlay {
    top: 12px; left: 12px;
    padding: 16px;
    width: 310px;
    max-height: calc(100% - 24px);
    overflow-y: auto;
  }

  .plan-instruction {
    font-size: 11px;
    color: #94a3b8;
    line-height: 1.5;
    margin-bottom: 12px;
    background: rgba(30, 41, 59, 0.5);
    padding: 8px 10px;
    border-radius: 6px;
    border-left: 3px solid #0ea5e9;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 12px;
  }
  .metric-card {
    background: rgba(30, 41, 59, 0.7);
    padding: 8px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .metric-card.full-width { grid-column: span 2; }
  .metric-val { font-size: 14px; font-weight: 700; color: #f8fafc; font-family: 'Outfit', sans-serif; }
  .metric-lbl { font-size: 9px; color: #94a3b8; text-transform: uppercase; margin-top: 2px; }

  /* Controls */
  .control-group {
    margin-bottom: 12px;
  }
  .control-label {
    font-size: 11px;
    color: #cbd5e1;
    font-weight: 600;
    margin-bottom: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .spacing-input-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .spacing-input-wrap input {
    width: 100%;
    padding: 6px 10px;
    background: rgba(30, 41, 59, 0.9);
    border: 1px solid rgba(14, 165, 233, 0.3);
    border-radius: 6px;
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
    outline: none;
  }
  .spacing-input-wrap input:focus { border-color: #38bdf8; box-shadow: 0 0 8px rgba(56,189,248,0.3); }

  .plan-btns { display: flex; flex-direction: column; gap: 6px; }
  .plan-btn {
    padding: 9px 12px;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
  }
  .plan-btn:hover:not(:disabled)   { opacity: 0.9; transform: translateY(-1px); }
  .plan-btn:active:not(:disabled)  { transform: translateY(0); }
  .plan-btn:disabled { opacity: 0.35; cursor: not-allowed; transform: none !important; }

  .btn-cyan    { background: linear-gradient(135deg, #0ea5e9, #0284c7); color: #fff; }
  .btn-indigo  { background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; }
  .btn-green   { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; }
  .btn-amber   { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; }
  .btn-danger  { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
  .btn-secondary { background: rgba(51, 65, 85, 0.8); color: #e2e8f0; border: 1px solid rgba(255,255,255,0.1); }

  /* Warning box */
  .alert-box {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
    font-size: 11px;
    padding: 8px 10px;
    border-radius: 6px;
    margin-bottom: 10px;
    display: none;
    align-items: center;
    gap: 6px;
  }

  /* ── LIVE OVERLAYS ── */
  #live-left {
    top: 12px; left: 12px;
    padding: 14px 16px;
    min-width: 220px;
  }
  #live-right {
    top: 12px; right: 12px;
    padding: 14px 16px;
    min-width: 210px;
  }

  .sl { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 4px 0; }
  .sl-lbl { color: #94a3b8; font-size: 11px; }
  .sl-val { font-weight: 700; color: #f8fafc; font-size: 12px; font-family: 'Outfit', sans-serif; }
  .green  { color: #4ade80 !important; }
  .amber  { color: #fbbf24 !important; }
  .red    { color: #f87171 !important; }

  .bat-track { width: 100%; height: 6px; background: rgba(30, 41, 59, 0.8); border-radius: 3px; margin: 4px 0 6px; }
  .bat-fill  { height: 100%; background: linear-gradient(90deg, #0ea5e9, #38bdf8); border-radius: 3px; transition: width 0.5s; }

  .divider { border-top: 1px solid rgba(14, 165, 233, 0.15); margin: 8px 0; }

  /* ── CAMERA LOCK CONTROL ── */
  #lock-cam-box {
    bottom: 16px; left: 12px;
    padding: 8px 14px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: #e2e8f0;
  }
  .tog { position: relative; width: 36px; height: 18px; }
  .tog input { display: none; }
  .tog-track {
    position: absolute; inset: 0;
    border-radius: 10px; background: #334155;
    cursor: pointer; transition: background 0.2s;
  }
  .tog-track::after {
    content: ''; position: absolute;
    top: 2px; left: 2px;
    width: 14px; height: 14px;
    border-radius: 50%; background: #fff;
    transition: transform 0.2s;
  }
  .tog input:checked + .tog-track { background: #0ea5e9; }
  .tog input:checked + .tog-track::after { transform: translateX(18px); }

  /* Custom marker pulse */
  .start-vertex-marker {
    background: #22c55e;
    border: 2px solid #ffffff;
    box-shadow: 0 0 12px #22c55e;
    border-radius: 50%;
  }
</style>

<!-- ═══════════════════ HTML ═══════════════════ -->
<div id="mission-app">

  <!-- DISCLAIMER BANNER -->
  <div class="sim-disclaimer-bar">
    <i class="fa-solid fa-flask"></i>
    <span>SIMULATION MODE — Autonomous coverage route generator & mission playback. No real robot commands are transmitted.</span>
  </div>

  <!-- STATS BAR -->
  <div id="stats-bar">
    <div class="stat-item">
      <span class="stat-icon">📍</span>
      <div><div class="stat-num" id="sb-vertices">0</div><div class="stat-lbl">Vertices</div></div>
    </div>
    <div class="stat-item">
      <span class="stat-icon">🤖</span>
      <div><div class="stat-num" id="sb-wps">0</div><div class="stat-lbl">Coverage Pts</div></div>
    </div>
    <div class="stat-item">
      <span class="stat-icon">📏</span>
      <div><div class="stat-num" id="sb-dist">0.00 km</div><div class="stat-lbl">Route Dist</div></div>
    </div>
    <div class="stat-item">
      <span class="stat-icon">⏱️</span>
      <div><div class="stat-num" id="sb-eta">--</div><div class="stat-lbl">Est. Time</div></div>
    </div>
    <div class="stat-item">
      <span class="stat-icon">🔋</span>
      <div><div class="stat-num" id="sb-bat" style="color:#4ade80">100%</div><div class="stat-lbl">Battery</div></div>
    </div>
  </div>

  <!-- MISSION HEADER WITH COMPACT SWITCHER -->
  <div id="mission-header">
    <div class="header-brand-wrap">
      <span>
        <i class="fa-solid fa-compass-drafting" style="margin-right:6px;color:#38bdf8;"></i>
        <span id="hdr-title">Autonomous Coverage Planner</span>
      </span>

      <!-- COMPACT TWO-TAB SWITCHER -->
      <div class="view-switcher-pills">
        <button class="view-pill active" id="view-btn-plan" onclick="switchView('plan')">
          <i class="fa-solid fa-map-location-dot"></i> Plan Path
        </button>
        <button class="view-pill" id="view-btn-live" onclick="switchView('live')">
          <i class="fa-solid fa-location-crosshairs"></i> Live Track
        </button>
      </div>
    </div>

    <span class="state-badge state-PLANNING" id="state-badge">PLANNING</span>
  </div>

  <div id="map-container">
    <div id="mission-map"></div>

    <!-- PLAN OVERLAY -->
    <div class="m-overlay dark-panel" id="plan-overlay">
      <div class="panel-title">
        <i class="fa-solid fa-draw-polygon"></i> Boundary Planner
      </div>

      <div class="plan-instruction" id="plan-instruction">
        Click on the map to place boundary vertices for the coverage area. Click the 1st vertex or "Finish Boundary" when done.
      </div>

      <div class="alert-box" id="plan-alert">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span id="alert-text">Warning</span>
      </div>

      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-val" id="m-vertices">0</div>
          <div class="metric-lbl">Vertices</div>
        </div>
        <div class="metric-card">
          <div class="metric-val" id="m-status-text">Open</div>
          <div class="metric-lbl">Boundary Status</div>
        </div>
        <div class="metric-card">
          <div class="metric-val" id="m-pts">0</div>
          <div class="metric-lbl">Coverage Pts</div>
        </div>
        <div class="metric-card">
          <div class="metric-val" id="m-dist">0.00 km</div>
          <div class="metric-lbl">Est. Path</div>
        </div>
      </div>

      <div class="control-group">
        <div class="control-label">
          <span>Scanline Spacing (m)</span>
          <span id="spacing-val-disp">60m</span>
        </div>
        <div class="spacing-input-wrap">
          <input type="number" id="spacing-input" value="60" min="20" max="250" step="10" onchange="onSpacingChange()" onkeyup="onSpacingChange()">
        </div>
      </div>

      <div class="plan-btns">
        <button class="plan-btn btn-secondary" id="btn-finish" disabled onclick="finishBoundary()">
          <i class="fa-solid fa-check"></i> Finish Boundary
        </button>
        <button class="plan-btn btn-secondary" id="btn-undo" disabled onclick="undoLastPoint()">
          <i class="fa-solid fa-rotate-left"></i> Undo Point
        </button>
        <button class="plan-btn btn-cyan" id="btn-generate" disabled onclick="generateCoverageRoute()">
          <i class="fa-solid fa-route"></i> Generate Route
        </button>
        <button class="plan-btn btn-green" id="btn-start" disabled onclick="startMission()">
          <i class="fa-solid fa-play"></i> Start Mission
        </button>
        <button class="plan-btn btn-amber" id="btn-pause" style="display:none;" onclick="pauseMission()">
          <i class="fa-solid fa-pause"></i> Pause Mission
        </button>
        <button class="plan-btn btn-green" id="btn-resume" style="display:none;" onclick="resumeMission()">
          <i class="fa-solid fa-play"></i> Resume Mission
        </button>
        <button class="plan-btn btn-danger" id="btn-abort" style="display:none;" onclick="abortMission()">
          <i class="fa-solid fa-stop"></i> Abort Mission
        </button>
        <button class="plan-btn btn-secondary" id="btn-clear" onclick="resetPlanner()">
          <i class="fa-solid fa-trash-can"></i> Clear / Reset
        </button>
      </div>
    </div>

    <!-- LIVE LEFT PANEL -->
    <div class="m-overlay dark-panel" id="live-left" style="display:none">
      <div class="panel-title"><i class="fa-solid fa-robot"></i> Telemetry (Simulated)</div>
      <div class="sl">
        <span class="sl-lbl">State</span>
        <span class="sl-val green" id="l-state-str">Running</span>
      </div>
      <div class="sl"><span class="sl-lbl">Battery</span><span class="sl-val" id="l-bat">100%</span></div>
      <div class="bat-track"><div class="bat-fill" id="bat-fill" style="width:100%"></div></div>
      <div class="divider"></div>
      <div class="sl"><span class="sl-lbl">pH Level</span><span class="sl-val" id="l-ph">7.20</span></div>
      <div class="sl"><span class="sl-lbl">Turbidity</span><span class="sl-val" id="l-turb">11.4 NTU</span></div>
      <div class="sl"><span class="sl-lbl">Temp</span><span class="sl-val" id="l-temp">26.5 °C</span></div>
    </div>

    <!-- LIVE RIGHT PANEL -->
    <div class="m-overlay dark-panel" id="live-right" style="display:none">
      <div class="panel-title"><i class="fa-solid fa-chart-line"></i> Mission Progress</div>
      <div class="sl"><span class="sl-lbl">Target Waypoint</span><span class="sl-val" id="l-wp">0 / 0</span></div>
      <div class="sl"><span class="sl-lbl">Total Dist</span><span class="sl-val" id="l-total-dist">0.00 km</span></div>
      <div class="sl"><span class="sl-lbl">Traveled</span><span class="sl-val" id="l-trav-dist">0.00 km</span></div>
      <div class="sl"><span class="sl-lbl">Remaining</span><span class="sl-val" id="l-rem-dist">0.00 km</span></div>
      <div class="sl"><span class="sl-lbl">Est. Speed</span><span class="sl-val" id="l-spd">1.50 m/s</span></div>
      <div class="sl"><span class="sl-lbl">ETA</span><span class="sl-val" id="l-eta">--</span></div>
    </div>

    <!-- LOCK CAMERA CONTROL -->
    <div class="m-overlay dark-panel" id="lock-cam-box" style="display:none">
      <label class="tog">
        <input type="checkbox" id="lock-toggle" checked onchange="lockCam=this.checked">
        <div class="tog-track"></div>
      </label>
      <span>Follow Robot Position</span>
    </div>

  </div>
</div>

<!-- ═══════════════════ SCRIPTS ═══════════════════ -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>

<script>
// ── FIREBASE INIT ──
const firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;
if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
const db = firebase.database();

// ── STATE MACHINE & VARIABLES ──
let missionState = 'PLANNING';
let areaPts = [];               // LatLng vertices [{lat, lng}]
let isClosed = false;            // Polygon boundary closed flag
let vertexMarkers = [];          // Leaflet circle markers for vertices
let areaPoly = null;             // Leaflet polygon layer
let coverageMarkersGroup = null; // Leaflet LayerGroup for points
let plannedPolyline = null;      // Polyline for serpentine path
let traveledPolyline = null;     // Polyline for actual robot trajectory
let scanWaypoints = [];          // Ordered route waypoints [{lat, lng, x, y}]
let traveledPath = [];           // Array of [lat, lng]
let robotMarker = null;          // Robot marker layer
let animTimer = null;            // Animation loop handle
let currentWpIdx = 0;            // Current target waypoint index
let lockCam = true;
let totalRouteDistM = 0;         // Total planned distance in meters

// ── LEAFLET MAP INIT ──
const map = L.map('mission-map', { zoomControl: false }).setView([11.0168, 76.9558], 15);
L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png', {
  attribution: '© OpenStreetMap © CARTO', maxZoom: 19
}).addTo(map);
L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}{r}.png', {
  attribution: '', maxZoom: 19, pane: 'overlayPane'
}).addTo(map);

coverageMarkersGroup = L.layerGroup().addTo(map);

// Invalidate size on load
setTimeout(() => { map.invalidateSize(); }, 300);
window.addEventListener('resize', () => map.invalidateSize());

// ── STATE UI UPDATER ──
function setMissionState(newState) {
  missionState = newState;
  const badge = document.getElementById('state-badge');
  badge.className = `state-badge state-${newState}`;
  badge.textContent = newState;

  const isPlanning = newState === 'PLANNING';
  const isReady    = newState === 'READY';
  const isRunning  = newState === 'RUNNING';
  const isPaused   = newState === 'PAUSED';
  const isFinished = newState === 'COMPLETED' || newState === 'ABORTED';

  // Toggle buttons
  document.getElementById('spacing-input').disabled = !isPlanning && !isReady;
  document.getElementById('btn-finish').disabled   = !isPlanning || areaPts.length < 3 || isClosed;
  document.getElementById('btn-undo').disabled     = !isPlanning || areaPts.length === 0;
  document.getElementById('btn-generate').disabled = (!isPlanning && !isReady) || areaPts.length < 3;
  document.getElementById('btn-start').disabled    = !isReady;

  document.getElementById('btn-start').style.display  = (isPlanning || isReady) ? 'flex' : 'none';
  document.getElementById('btn-pause').style.display  = isRunning ? 'flex' : 'none';
  document.getElementById('btn-resume').style.display = isPaused ? 'flex' : 'none';
  document.getElementById('btn-abort').style.display  = (isRunning || isPaused) ? 'flex' : 'none';
  document.getElementById('btn-clear').style.display  = 'flex';

  if (isRunning) {
    document.getElementById('plan-instruction').textContent = 'Mission in progress. Telemetry data is updated in real-time.';
  } else if (isPaused) {
    document.getElementById('plan-instruction').textContent = 'Mission paused. Resume when ready or abort to re-plan.';
  } else if (isFinished) {
    document.getElementById('plan-instruction').textContent = `Mission ${newState.toLowerCase()}. Click Clear / Reset to start a new mission.`;
  } else if (isClosed) {
    document.getElementById('plan-instruction').textContent = 'Boundary closed! Click "Generate Route" to compute the coverage path.';
  } else {
    document.getElementById('plan-instruction').textContent = 'Click on the map to place boundary vertices for the coverage area. Click the 1st vertex or "Finish Boundary" when done.';
  }
}

// ── ALERT DISPLAY ──
function showAlert(msg) {
  const box = document.getElementById('plan-alert');
  const txt = document.getElementById('alert-text');
  if (msg) {
    txt.textContent = msg;
    box.style.display = 'flex';
  } else {
    box.style.display = 'none';
  }
}

// ── MAP CLICK EVENT HANDLER ──
map.on('click', (e) => {
  if (missionState !== 'PLANNING' && missionState !== 'READY') return;
  if (isClosed) return; // Must reset to draw new boundary

  const { lat, lng } = e.latlng;

  // Check if click is close to 1st vertex to close boundary
  if (areaPts.length >= 3) {
    const p1 = map.latLngToLayerPoint([areaPts[0].lat, areaPts[0].lng]);
    const pClick = map.latLngToLayerPoint([lat, lng]);
    if (p1.distanceTo(pClick) < 22) { // 22px tolerance
      finishBoundary();
      return;
    }
  }

  areaPts.push({ lat, lng });
  if (missionState === 'READY') setMissionState('PLANNING');
  renderBoundary();
});

// ── BOUNDARY GEOMETRY & SELF-INTERSECTION ──
function checkSelfIntersection(pts) {
  if (pts.length < 4) return false;
  const p = pts.map(pt => map.latLngToLayerPoint([pt.lat, pt.lng]));
  const n = p.length;

  for (let i = 0; i < n; i++) {
    const a1 = p[i], a2 = p[(i + 1) % n];
    for (let j = i + 2; j < n; j++) {
      if (i === 0 && j === n - 1) continue;
      const b1 = p[j], b2 = p[(j + 1) % n];
      if (linesIntersect(a1, a2, b1, b2)) return true;
    }
  }
  return false;
}

function linesIntersect(p1, p2, p3, p4) {
  function ccw(A, B, C) {
    return (C.y - A.y) * (B.x - A.x) > (B.y - A.y) * (C.x - A.x);
  }
  return (ccw(p1, p3, p4) !== ccw(p2, p3, p4)) && (ccw(p1, p2, p3) !== ccw(p1, p2, p4));
}

function renderBoundary() {
  vertexMarkers.forEach(m => map.removeLayer(m)); vertexMarkers = [];
  if (areaPoly) { map.removeLayer(areaPoly); areaPoly = null; }

  areaPts.forEach((pt, idx) => {
    const isFirst = idx === 0;
    const m = L.circleMarker([pt.lat, pt.lng], {
      radius: isFirst ? 7 : 5,
      color: isFirst ? '#22c55e' : '#38bdf8',
      fillColor: isFirst ? '#22c55e' : '#0ea5e9',
      fillOpacity: 1,
      weight: isFirst ? 3 : 2
    }).addTo(map);

    if (isFirst) {
      m.bindTooltip("Start Vertex (Click to Close)", { permanent: false, direction: 'top' });
    }
    vertexMarkers.push(m);
  });

  const intersects = checkSelfIntersection(areaPts);
  if (intersects) {
    showAlert('Boundary self-intersects! Please undo or adjust vertices.');
  } else {
    showAlert(null);
  }

  if (areaPts.length >= 2) {
    const latLngs = areaPts.map(p => [p.lat, p.lng]);
    areaPoly = L.polygon(latLngs, {
      color: isClosed ? '#0ea5e9' : '#f59e0b',
      dashArray: isClosed ? null : '6, 6',
      weight: 2.5,
      fillColor: '#0ea5e9',
      fillOpacity: isClosed ? 0.15 : 0.05
    }).addTo(map);
  }

  document.getElementById('m-vertices').textContent = areaPts.length;
  document.getElementById('sb-vertices').textContent = areaPts.length;
  document.getElementById('m-status-text').textContent = isClosed ? 'Closed' : (areaPts.length >= 3 ? 'Open (Ready to Close)' : 'Open');
  document.getElementById('btn-finish').disabled = areaPts.length < 3 || isClosed || intersects;
  document.getElementById('btn-undo').disabled = areaPts.length === 0;
  document.getElementById('btn-generate').disabled = areaPts.length < 3 || intersects;
}

function finishBoundary() {
  if (areaPts.length < 3) return;
  if (checkSelfIntersection(areaPts)) {
    showAlert('Cannot close self-intersecting boundary.');
    return;
  }
  isClosed = true;
  renderBoundary();
  setMissionState('PLANNING');
}

function undoLastPoint() {
  if (areaPts.length === 0) return;
  areaPts.pop();
  isClosed = false;
  if (missionState === 'READY') setMissionState('PLANNING');
  clearRouteVisuals();
  renderBoundary();
}

function onSpacingChange() {
  const inp = document.getElementById('spacing-input');
  let val = parseInt(inp.value, 10);
  if (isNaN(val) || val < 20) val = 20;
  if (val > 250) val = 250;
  document.getElementById('spacing-val-disp').textContent = val + 'm';
  if (isClosed && scanWaypoints.length > 0 && (missionState === 'PLANNING' || missionState === 'READY')) {
    generateCoverageRoute();
  }
}

// ── LOCAL PROJECTION & ADAPTIVE DENSITY COVERAGE GENERATION ──
function toLocalMeters(lat, lng, origin) {
  const R = 6371000, r = Math.PI / 180;
  return {
    x: (lng - origin.lng) * r * R * Math.cos(origin.lat * r),
    y: (lat - origin.lat) * r * R
  };
}

function toLatLng(x, y, origin) {
  const R = 6371000, r = Math.PI / 180;
  return {
    lat: origin.lat + (y / R) / r,
    lng: origin.lng + (x / (R * Math.cos(origin.lat * r))) / r
  };
}

function pointInPolygonLocal(pt, polyLocal) {
  let inside = false;
  for (let i = 0, j = polyLocal.length - 1; i < polyLocal.length; j = i++) {
    const xi = polyLocal[i].x, yi = polyLocal[i].y;
    const xj = polyLocal[j].x, yj = polyLocal[j].y;
    const intersect = ((yi > pt.y) !== (yj > pt.y)) && (pt.x < (xj - xi) * (pt.y - yi) / (yj - yi) + xi);
    if (intersect) inside = !inside;
  }
  return inside;
}

function generateCoverageRoute() {
  if (areaPts.length < 3) return;
  if (checkSelfIntersection(areaPts)) {
    showAlert('Fix self-intersecting boundary before generating route.');
    return;
  }

  if (!isClosed) finishBoundary();

  let spacingM = parseInt(document.getElementById('spacing-input').value, 10) || 60;
  const origin = areaPts[0];
  const polyLocal = areaPts.map(p => toLocalMeters(p.lat, p.lng, origin));

  const minX = Math.min(...polyLocal.map(p => p.x));
  const maxX = Math.max(...polyLocal.map(p => p.x));
  const minY = Math.min(...polyLocal.map(p => p.y));
  const maxY = Math.max(...polyLocal.map(p => p.y));

  // Adaptive Density Control: Ensure points stay in a clean, readable range (~15-35 max)
  const spanX = maxX - minX;
  const spanY = maxY - minY;
  const maxSpan = Math.max(spanX, spanY);
  if (maxSpan > 0) {
    const minRecSpacing = Math.ceil(maxSpan / 6); // Max 6 scanline rows
    if (spacingM < minRecSpacing) {
      spacingM = minRecSpacing;
      document.getElementById('spacing-input').value = spacingM;
      document.getElementById('spacing-val-disp').textContent = spacingM + 'm';
    }
  }

  const rows = [];
  let totalCandidates = 0;

  for (let y = minY + spacingM / 2; y <= maxY; y += spacingM) {
    const rowPts = [];
    for (let x = minX + spacingM / 2; x <= maxX; x += spacingM) {
      if (pointInPolygonLocal({ x, y }, polyLocal)) {
        rowPts.push({ x, y });
        totalCandidates++;
      }
    }
    if (rowPts.length > 0) {
      rows.push(rowPts);
    }
  }

  if (totalCandidates === 0) {
    showAlert('No coverage points fit inside boundary. Reduce spacing slightly.');
    return;
  }

  showAlert(null);

  // Serpentine scanline ordering
  scanWaypoints = [];
  rows.forEach((row, rIdx) => {
    row.sort((a, b) => a.x - b.x);
    if (rIdx % 2 === 1) row.reverse();
    row.forEach(ptLocal => {
      const ll = toLatLng(ptLocal.x, ptLocal.y, origin);
      scanWaypoints.push({ lat: ll.lat, lng: ll.lng, x: ptLocal.x, y: ptLocal.y });
    });
  });

  totalRouteDistM = 0;
  for (let i = 1; i < scanWaypoints.length; i++) {
    totalRouteDistM += haversineM(scanWaypoints[i - 1], scanWaypoints[i]);
  }

  renderRouteVisuals();
  setMissionState('READY');
}

function clearRouteVisuals() {
  coverageMarkersGroup.clearLayers();
  if (plannedPolyline) { map.removeLayer(plannedPolyline); plannedPolyline = null; }
  if (traveledPolyline) { map.removeLayer(traveledPolyline); traveledPolyline = null; }
  scanWaypoints = [];
  totalRouteDistM = 0;
  document.getElementById('m-pts').textContent = '0';
  document.getElementById('m-dist').textContent = '0.00 km';
  document.getElementById('sb-wps').textContent = '0';
  document.getElementById('sb-dist').textContent = '0.00 km';
  document.getElementById('sb-eta').textContent = '--';
}

function renderRouteVisuals() {
  coverageMarkersGroup.clearLayers();
  if (plannedPolyline) map.removeLayer(plannedPolyline);

  // Render clean, distinct coverage point dots
  scanWaypoints.forEach((wp, i) => {
    L.circleMarker([wp.lat, wp.lng], {
      radius: 4,
      color: '#38bdf8',
      fillColor: '#0ea5e9',
      fillOpacity: 0.85,
      weight: 1.5
    }).addTo(coverageMarkersGroup);
  });

  const latLngs = scanWaypoints.map(w => [w.lat, w.lng]);
  plannedPolyline = L.polyline(latLngs, {
    color: '#38bdf8',
    weight: 2.5,
    opacity: 0.9,
    dashArray: '4, 4'
  }).addTo(map);

  const distKm = (totalRouteDistM / 1000).toFixed(2);
  const estSec = totalRouteDistM / 1.5;
  const etaStr = formatTime(estSec);

  document.getElementById('m-pts').textContent = scanWaypoints.length;
  document.getElementById('m-dist').textContent = distKm + ' km';
  document.getElementById('sb-wps').textContent = scanWaypoints.length;
  document.getElementById('sb-dist').textContent = distKm + ' km';
  document.getElementById('sb-eta').textContent = etaStr;

  if (areaPoly) map.fitBounds(areaPoly.getBounds(), { padding: [40, 40] });
}

// ── SIMULATION PLAYBACK ──
function startMission() {
  if (scanWaypoints.length === 0) return;
  setMissionState('RUNNING');

  db.ref('aqunex/mission').set({
    status: 'active',
    mode: 'simulation',
    hardwareCommandSent: false,
    totalWaypoints: scanWaypoints.length,
    deployedAt: Date.now()
  });

  currentWpIdx = 0;
  traveledPath = [[scanWaypoints[0].lat, scanWaypoints[0].lng]];

  if (traveledPolyline) map.removeLayer(traveledPolyline);
  traveledPolyline = L.polyline(traveledPath, {
    color: '#4ade80',
    weight: 3.5,
    opacity: 0.95
  }).addTo(map);

  switchView('live');
  runSimulationLoop();
}

function runSimulationLoop() {
  if (animTimer) clearInterval(animTimer);

  const SPEED_MS = 1.8;
  const TICK_MS = 100;
  let segIdx = currentWpIdx;
  let segProgress = 0;

  animTimer = setInterval(() => {
    if (missionState !== 'RUNNING') return;

    if (segIdx >= scanWaypoints.length - 1) {
      clearInterval(animTimer);
      setMissionState('COMPLETED');
      db.ref('aqunex/mission/status').set('completed');
      document.getElementById('l-state-str').textContent = 'Completed';
      document.getElementById('l-state-str').className = 'sl-val green';
      return;
    }

    const pFrom = scanWaypoints[segIdx];
    const pTo = scanWaypoints[segIdx + 1];
    const distM = Math.max(haversineM(pFrom, pTo), 0.1);
    const stepRatio = (SPEED_MS * (TICK_MS / 1000)) / distM;

    segProgress += stepRatio;

    if (segProgress >= 1) {
      segProgress = 0;
      segIdx++;
      currentWpIdx = segIdx;
    }

    const currLat = pFrom.lat + segProgress * (pTo.lat - pFrom.lat);
    const currLng = pFrom.lng + segProgress * (pTo.lng - pFrom.lng);

    placeRobotMarker(currLat, currLng);

    traveledPath.push([currLat, currLng]);
    if (traveledPolyline) traveledPolyline.setLatLngs(traveledPath);

    const completedRatio = Math.min(1, segIdx / (scanWaypoints.length - 1));
    const traveledDistM = completedRatio * totalRouteDistM;
    const remainingM = Math.max(0, totalRouteDistM - traveledDistM);
    const etaSec = remainingM / SPEED_MS;

    document.getElementById('l-wp').textContent = `${segIdx + 1} / ${scanWaypoints.length}`;
    document.getElementById('l-total-dist').textContent = (totalRouteDistM / 1000).toFixed(2) + ' km';
    document.getElementById('l-trav-dist').textContent = (traveledDistM / 1000).toFixed(2) + ' km';
    document.getElementById('l-rem-dist').textContent = (remainingM / 1000).toFixed(2) + ' km';
    document.getElementById('l-spd').textContent = (SPEED_MS + (Math.random() - 0.5) * 0.1).toFixed(2) + ' m/s';
    document.getElementById('l-eta').textContent = formatTime(etaSec);

    document.getElementById('l-ph').textContent = (7.2 + (Math.random() - 0.5) * 0.2).toFixed(2);
    document.getElementById('l-turb').textContent = (11.4 + (Math.random() - 0.5) * 1.5).toFixed(1) + ' NTU';
    document.getElementById('l-temp').textContent = (26.5 + (Math.random() - 0.5) * 0.3).toFixed(1) + ' °C';

    const bat = Math.max(70, 100 - Math.floor(completedRatio * 20));
    document.getElementById('l-bat').textContent = bat + '%';
    document.getElementById('sb-bat').textContent = bat + '%';
    document.getElementById('bat-fill').style.width = bat + '%';
  }, TICK_MS);
}

function pauseMission() {
  setMissionState('PAUSED');
  document.getElementById('l-state-str').textContent = 'Paused';
  document.getElementById('l-state-str').className = 'sl-val amber';
}

function resumeMission() {
  setMissionState('RUNNING');
  document.getElementById('l-state-str').textContent = 'Running';
  document.getElementById('l-state-str').className = 'sl-val green';
}

function abortMission() {
  if (animTimer) clearInterval(animTimer);
  setMissionState('ABORTED');
  db.ref('aqunex/mission/status').set('aborted');
  document.getElementById('l-state-str').textContent = 'Aborted';
  document.getElementById('l-state-str').className = 'sl-val red';
}

function resetPlanner() {
  if (animTimer) clearInterval(animTimer);
  areaPts = [];
  isClosed = false;
  clearRouteVisuals();
  renderBoundary();
  if (robotMarker) { map.removeLayer(robotMarker); robotMarker = null; }
  setMissionState('PLANNING');
  switchView('plan');
}

function placeRobotMarker(lat, lng) {
  if (!robotMarker) {
    const icon = L.divIcon({
      html: `<div style="width:20px;height:20px;background:#38bdf8;border:3px solid #ffffff;border-radius:50%;box-shadow:0 0 16px #38bdf8;"></div>`,
      iconSize: [20, 20],
      iconAnchor: [10, 10]
    });
    robotMarker = L.marker([lat, lng], { icon }).addTo(map);
  } else {
    robotMarker.setLatLng([lat, lng]);
  }
  if (lockCam) map.panTo([lat, lng], { animate: true, duration: 0.2 });
}

// ── UTILS ──
function haversineM(a, b) {
  const R = 6371000, r = Math.PI / 180;
  const dLat = (b.lat - a.lat) * r, dLng = (b.lng - a.lng) * r;
  const x = Math.sin(dLat / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1 - x));
}

function formatTime(sec) {
  if (isNaN(sec) || sec <= 0) return '0m 0s';
  const m = Math.floor(sec / 60);
  const s = Math.floor(sec % 60);
  return `${m}m ${s}s`;
}

// ── COMPACT TWO-VIEW SWITCHER ──
function switchView(tab) {
  const isPlan = tab === 'plan';
  document.getElementById('view-btn-plan').classList.toggle('active', isPlan);
  document.getElementById('view-btn-live').classList.toggle('active', !isPlan);

  ['plan-overlay', 'live-left', 'live-right', 'lock-cam-box'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
  });

  if (isPlan) {
    document.getElementById('hdr-title').textContent = 'Autonomous Coverage Planner';
    document.getElementById('plan-overlay').style.display = 'block';
  } else {
    document.getElementById('hdr-title').textContent = 'Live Mission Tracking';
    document.getElementById('live-left').style.display = 'block';
    document.getElementById('live-right').style.display = 'block';
    document.getElementById('lock-cam-box').style.display = 'flex';
  }

  setTimeout(() => map.invalidateSize(), 200);
}

// Initialize default state
setMissionState('PLANNING');
</script>

