        <script>
          document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.compare-slider').forEach(slider => {
              const range = slider.querySelector('.compare-range');
              const after = slider.querySelector('.compare-after');
              const handle = slider.querySelector('.compare-handle');
              if (!range || !after || !handle) return;

              const update = () => {
                const val = range.value;
                after.style.clipPath = `inset(0 0 0 ${val}%)`;
                handle.style.left = `${val}%`;
              };

              range.addEventListener('input', () => {
                update();
                slider.classList.add('interacted');
              });
              range.addEventListener('change', () => {
                slider.classList.add('interacted');
              });

              update();
            });
          });
