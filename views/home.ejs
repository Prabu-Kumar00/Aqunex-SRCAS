                <li>AS7265x Spectral Sensors</li>
                <li>pH &amp; Turbidity Sensors</li>
                <li>GPS + IMU Navigation</li>
                <li>Camera Module (YOLO)</li>
              </ul>
            </div>
            <div class="tech-card">
              <h3>🛠️ Software Stack</h3>
              <ul>
                <li>Node.js + Express Backend</li>
                <li>EJS Templating</li>
                <li>Firebase Firestore</li>
                <li>YOLO v8 ML Model</li>
                <li>Leaflet.js Maps</li>
                <li>Spectral Analysis Algorithms</li>
              </ul>
            </div>
            <div class="tech-card">
              <h3>🎯 Key Features</h3>
              <ul>
                <li>Real-time Water Monitoring</li>
                <li>Chlorophyll-a Detection</li>
                <li>Plastic Debris Identification</li>
                <li>Autonomous Navigation</li>
                <li>Cloud-based Dashboard</li>
              </ul>
            </div>
          </div>
        </div>

        <script>
          document.addEventListener('DOMContentLoaded', () => {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              document.querySelectorAll('.overview-grid .tech-card').forEach(c => {
                c.style.opacity = '1';
                c.style.transform = 'none';
              });
              return;
            }

            const initOverviewGSAP = () => {
              if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
                setTimeout(initOverviewGSAP, 100);
                return;
              }
              gsap.registerPlugin(ScrollTrigger);
              const cards = document.querySelectorAll('.overview-grid .tech-card');
              if (!cards.length) return;

              gsap.set(cards, {
                opacity: 0,
                rotateX: -15,
                y: 40,
                transformOrigin: 'top center'
              });

              gsap.to(cards, {
                opacity: 1,
                rotateX: 0,
                y: 0,
                duration: 0.9,
                ease: 'power3.out',
                stagger: 0.15,
                scrollTrigger: {
                  trigger: '.overview-grid',
                  start: 'top 80%',
                  toggleActions: 'play none none none'
                }
              });
            };

            initOverviewGSAP();
          });
        </script>
      </div>
