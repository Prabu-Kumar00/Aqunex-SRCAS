    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const chartSection = document.querySelector('.readings-section');
        const canvas = document.getElementById('readingsChart');
        if (!chartSection || !canvas) return;

        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let chartInstance = null;

        const initChart = () => {
          if (chartInstance || typeof Chart === 'undefined') return;
          const ctx = canvas.getContext('2d');
          const locations = ['Ukkadam Lake', 'Valankulam', 'Kurichi Lake', 'Singanallur', 'Ooty Lake', 'Pulicat Lake'];

          chartInstance = new Chart(ctx, {
            type: 'line',
            data: {
              labels: locations,
              datasets: [
                {
                  label: 'pH Level',
                  data: [7.2, 7.8, 6.9, 8.1, 7.4, 7.6],
                  borderColor: '#0ea5e9',
                  backgroundColor: 'rgba(14, 165, 233, 0.15)',
                  borderWidth: 3,
                  tension: 0.35,
                  fill: true,
                  yAxisID: 'yPh'
                },
                {
                  label: 'Turbidity (NTU)',
                  data: [18, 34, 25, 42, 12, 29],
                  borderColor: '#8b5cf6',
                  backgroundColor: 'rgba(139, 92, 246, 0.12)',
                  borderWidth: 3,
                  tension: 0.35,
                  fill: true,
                  yAxisID: 'yVal'
                },
                {
                  label: 'Chlorophyll-a (µg/L)',
                  data: [12.5, 28.4, 19.1, 38.6, 9.8, 22.3],
                  borderColor: '#06b6d4',
                  backgroundColor: 'rgba(6, 182, 212, 0.12)',
                  borderWidth: 3,
                  tension: 0.35,
                  fill: true,
                  yAxisID: 'yVal'
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              animation: prefersReduced ? false : {
                duration: 1400,
                easing: 'easeOutQuart'
              },
              plugins: {
                legend: {
                  position: 'top',
                  labels: {
                    color: '#e2e8f0',
                    font: { family: "'Segoe UI', sans-serif", size: 13, weight: '600' },
                    usePointStyle: true,
                    padding: 20
                  }
                },
                tooltip: {
                  backgroundColor: '#0f172a',
                  titleColor: '#38bdf8',
                  bodyColor: '#f8fafc',
                  borderColor: 'rgba(14, 165, 233, 0.3)',
                  borderWidth: 1,
                  padding: 12,
                  boxPadding: 6
                }
              },
              scales: {
                x: {
                  grid: { color: 'rgba(255, 255, 255, 0.05)' },
                  ticks: { color: '#94a3b8', font: { size: 12 } }
                },
                yPh: {
                  type: 'linear',
                  position: 'left',
                  min: 5,
                  max: 10,
                  grid: { color: 'rgba(255, 255, 255, 0.05)' },
                  ticks: { color: '#0ea5e9', font: { size: 11 } },
                  title: { display: true, text: 'pH Level', color: '#0ea5e9', font: { size: 11, weight: 'bold' } }
                },
                yVal: {
                  type: 'linear',
                  position: 'right',
                  min: 0,
                  max: 50,
                  grid: { drawOnChartArea: false },
                  ticks: { color: '#38bdf8', font: { size: 11 } },
                  title: { display: true, text: 'NTU / µg/L', color: '#38bdf8', font: { size: 11, weight: 'bold' } }
                }
              }
            }
          });
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              initChart();
              obs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 });

        observer.observe(chartSection);
      });
    </script>

