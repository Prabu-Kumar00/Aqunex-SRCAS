        transform: translateY(0);
      }

      50% {
        transform: translateY(-6px);
      }
    }

    .feature-card:nth-child(2) .icon {
      animation-delay: -0.75s;
    }

    .feature-card:nth-child(3) .icon {
      animation-delay: -1.5s;
    }

    .feature-card:nth-child(4) .icon {
      animation-delay: -2.25s;
    }

