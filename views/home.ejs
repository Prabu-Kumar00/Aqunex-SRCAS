    <section class="project-overview reveal" id="overview">
      <div class="project-container">
        <h2 id="overviewTitle" class="blur-text-reveal">💡 Project Overview</h2>
        <style>
          .blur-text-reveal .blur-char {
            display: inline-block;
            opacity: 0;
            filter: blur(8px);
            transform: translateY(12px);
            color: #f8fafc !important;
            -webkit-text-fill-color: #f8fafc !important;
            white-space: pre;
          }

          .blur-text-reveal.animated .blur-char {
            animation: blurTextReveal 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
          }

          @keyframes blurTextReveal {
            to {
              opacity: 1;
              filter: blur(0);
              transform: translateY(0);
            }
          }
        </style>
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const title = document.getElementById('overviewTitle');
            if (!title) return;
            const text = title.innerText;
            title.innerHTML = Array.from(text).map((char, i) =>
              `<span class="blur-char" style="animation-delay:${i * 0.04}s;">${char === ' ' ? '&nbsp;' : char}</span>`
            ).join('');

            const observer = new IntersectionObserver((entries, obs) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  title.classList.add('animated');
                  obs.unobserve(entry.target);
                }
              });
            }, { threshold: 0.2 });

            observer.observe(title);
          });
        </script>
        <p class="subtitle">R-TECH: Robotic Monitoring for Chlorophyll and Plastic Signatures</p>
        <div class="overview-grid-wrap">
          <div class="overview-grid">
            <div class="tech-card">
