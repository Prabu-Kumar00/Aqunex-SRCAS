<nav class="main-nav">
    <a href="/" class="logo" style="text-decoration:none;"><span>🌊</span><span>R-TECH</span></a>

    <div class="main-nav-links">
        <a href="/"          class="nav-link<%= page === 'home'      ? ' active' : '' %>">Home</a>
        <a href="/dashboard" class="nav-link<%= page === 'dashboard' ? ' active' : '' %>">Dashboard</a>
        <a href="/reports"   class="nav-link<%= page === 'reports'   ? ' active' : '' %>">Reports</a>
        <a href="/mission"   class="nav-link<%= page === 'mission'   ? ' active' : '' %>">Mission</a>
    </div>

    <div class="nav-auth">
        <% if (typeof admin !== 'undefined' && admin) { %>
            <span class="admin-email">
                <i class="fa fa-circle" style="color:#3fb950;font-size:7px;vertical-align:middle;"></i>
                <%= admin.email %>
            </span>
            <a href="/auth/logout" class="auth-btn logout-btn">
                <i class="fa fa-right-from-bracket"></i> Logout
            </a>
        <% } else if (page !== 'login') { %>
            <a href="/login" class="auth-btn login-btn">
                <i class="fa fa-right-to-bracket"></i> Admin Login
            </a>
        <% } %>
    </div>
</nav>

