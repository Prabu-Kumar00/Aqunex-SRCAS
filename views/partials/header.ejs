        gap: 5px;
    }
    .auth-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: opacity 0.2s, transform 0.1s;
    }
